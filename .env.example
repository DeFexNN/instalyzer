# Copy these fields into your local .env. Keep cookie values private.
IG_USERNAME=your_own_username
IG_SESSIONID=
IG_CSRFTOKEN=
IG_DS_USER_ID=
IG_MID=
IG_IG_DID=
IG_RUR=
IG_DATR=
IG_DPR=
IG_IG_NRCB=
IG_PS_L=
IG_PS_N=
IG_RD_CHALLENGE=
IG_WD=
IG_INCLUDE_COMMENTS=true
IG_MAX_COMMENTS_PER_POST=100
IG_OUTPUT_DIR=exports
# auto: HikerAPI token first, then Apify, then the existing Instagram session.
INSTAGRAM_SCRAPER_PROVIDER=auto
APIFY_API_TOKEN=
APIFY_MAX_TOTAL_CHARGE_USD=0.5
# full uses one additional comments run when previews omit comments; preview is cheaper.
APIFY_COMMENTS_MODE=preview

# HikerAPI: no Instagram cookies, pay per request (~7 requests for a 65-post profile).
# CLI: python scrape_instagram_hiker.py <username> --limit 65
HIKERAPI_TOKEN=
HIKERAPI_BASE_URL=https://api.instagrapi.com
HIKERAPI_MAX_REQUESTS=40
HIKERAPI_COMMENTS=false
IG_MEDIA_DOWNLOAD_WORKERS=4
IG_COMPRESS_VIDEOS=true
FFMPEG_THREADS=2

# Experimental public-page fetch through Scrape.do (separate probe script).
SCRAPER_API_KEY=

# Experimental Crawlbase Instagram scrapers (separate probe script, JS token).
CRAWLBASE_API_KEY=

# OpenCode Go Muse Spark 1.3 Contributor; add a freshly rotated key locally.
OPENCODE_API_KEY=
OPENCODE_MODEL=muse-spark-1.3-contributor
OPENCODE_MAX_CONCURRENT_POST_ANALYSES=6
OPENCODE_MEDIA_PREPARATION_WORKERS=2
OPENCODE_MAX_MEDIA_PER_POST=6
OPENCODE_IMAGE_MAX_EDGE=768
OPENCODE_POST_MAX_OUTPUT_TOKENS=2048
OPENCODE_MAX_COMMENTS_PER_POST=100
OPENCODE_COMMENT_CHAR_BUDGET=20000
OPENCODE_POST_REASONING_EFFORT=minimal
OPENCODE_SYNTHESIS_REASONING_EFFORT=low
