# Paste these settings into Streamlit Cloud → App settings → Secrets.
# Real secrets.toml is ignored by Git. All values are strings.
APP_PASSWORD = "replace-with-a-long-random-demo-access-code"
APP_ENABLE_LIVE = "true"
APP_MAX_RUNS_PER_DAY = "10"
APP_LOW_CPU_MODE = "true"
INSTAGRAM_SCRAPER_PROVIDER = "auto"
APIFY_API_TOKEN = ""
APIFY_MAX_TOTAL_CHARGE_USD = "0.5"
APIFY_COMMENTS_MODE = "preview"

IG_USERNAME = "your_own_username"
IG_SESSIONID = ""
IG_CSRFTOKEN = ""
IG_DS_USER_ID = ""
IG_MID = ""
IG_IG_DID = ""
IG_RUR = ""
IG_DATR = ""
IG_MAX_COMMENTS_PER_POST = "100"

OPENCODE_API_KEY = ""
OPENCODE_MODEL = "muse-spark-1.3-contributor"
OPENCODE_IMAGE_MAX_EDGE = "768"
OPENCODE_MAX_MEDIA_PER_POST = "6"
OPENCODE_POST_MAX_OUTPUT_TOKENS = "2048"
OPENCODE_MAX_COMMENTS_PER_POST = "100"
OPENCODE_COMMENT_CHAR_BUDGET = "20000"
# Conservative defaults for a small shared cloud instance.
OPENCODE_MAX_CONCURRENT_POST_ANALYSES = "4"
IG_MEDIA_DOWNLOAD_WORKERS = "2"
